{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["*.ts", "../shared/contracts.ts", "../shared/domain.ts"]
}
